{
  "name": "dealer-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:run": "dotenv -e .env.test -- vitest run",
    "test:unit": "dotenv -e .env -- vitest run src/tests/unit",
    "test:db:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "test:server": "dotenv -e .env.test -- next dev -p 3001",
    "test:integration:run": "dotenv -e .env.test -- vitest run src/tests/integration --no-file-parallelism",
    "test:integration": "start-server-and-test test:server http://localhost:3001 test:integration:run",
    "test": "npm run test:unit && npm run test:integration",
    "vercel-build": "prisma generate && prisma migrate deploy && next build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.0",
    "jsonwebtoken": "^9.0.3",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
